{% extends 'base.html.twig' %}

{% block title %}Liste des Rendez-vous{% endblock %}

{% block body %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-calendar-alt mr-2"></i>Liste des Rendez-vous</h1>
    <a href="{{ path('app_rendez_vous_new') }}" class="btn btn-primary btn-sm shadow-sm">
        <i class="fas fa-plus fa-sm mr-1"></i> Nouveau Rendez-vous
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Rendez-vous enregistrés</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Heure</th>
                        <th>Patient</th>
                        <th>Médecin</th>
                        <th>Motif</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rdv in rendez_vous %}
                    <tr>
                        <td>{{ rdv.id }}</td>
                        <td><i class="fas fa-calendar mr-1 text-primary"></i>{{ rdv.date|date('d/m/Y') }}</td>
                        <td><i class="fas fa-clock mr-1 text-info"></i>{{ rdv.heure|date('H:i') }}</td>
                        <td>{{ rdv.patient }}</td>
                        <td>{{ rdv.medecin }}</td>
                        <td>{{ rdv.motif }}</td>
                        <td>
                            {% if rdv.statut == 'Confirmé' %}
                                <span class="badge badge-success">{{ rdv.statut }}</span>
                            {% elseif rdv.statut == 'En attente' %}
                                <span class="badge badge-warning">{{ rdv.statut }}</span>
                            {% elseif rdv.statut == 'Annulé' %}
                                <span class="badge badge-danger">{{ rdv.statut }}</span>
                            {% else %}
                                <span class="badge badge-info">{{ rdv.statut }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_rendez_vous_consult', {'id': rdv.id}) }}" class="btn btn-info btn-sm" title="Consulter">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('app_rendez_vous_edit', {'id': rdv.id}) }}" class="btn btn-warning btn-sm" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_rendez_vous_supp', {'id': rdv.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rendez-vous ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rdv.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4">
                            <i class="fas fa-calendar-times fa-2x text-gray-300 mb-2 d-block"></i>
                            Aucun rendez-vous enregistré.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
