{% extends 'base.html.twig' %}

{% block title %}Détails Patient{% endblock %}

{% block body %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-user mr-2"></i>Détails du Patient</h1>
    <a href="{{ path('app_patient_index') }}" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left mr-1"></i> Retour à la liste
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Informations du patient</h6>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <th class="text-gray-600" width="30%"><i class="fas fa-hashtag mr-2"></i>ID</th>
                        <td>{{ patient.id }}</td>
                    </tr>
                    <tr>
                        <th class="text-gray-600"><i class="fas fa-user mr-2"></i>Nom</th>
                        <td>{{ patient.nom }}</td>
                    </tr>
                    <tr>
                        <th class="text-gray-600"><i class="fas fa-user mr-2"></i>Prénom</th>
                        <td>{{ patient.prenom }}</td>
                    </tr>
                    <tr>
                        <th class="text-gray-600"><i class="fas fa-birthday-cake mr-2"></i>Âge</th>
                        <td>{{ patient.age }} ans</td>
                    </tr>
                    <tr>
                        <th class="text-gray-600"><i class="fas fa-phone mr-2"></i>Téléphone</th>
                        <td>{{ patient.telephone }}</td>
                    </tr>
                    <tr>
                        <th class="text-gray-600"><i class="fas fa-envelope mr-2"></i>Email</th>
                        <td>{{ patient.email }}</td>
                    </tr>
                    <tr>
                        <th class="text-gray-600"><i class="fas fa-map-marker-alt mr-2"></i>Adresse</th>
                        <td>{{ patient.adresse ?? 'Non renseignée' }}</td>
                    </tr>
                </table>
                <hr>
                <a href="{{ path('app_patient_edit', {'id': patient.id}) }}" class="btn btn-warning">
                    <i class="fas fa-edit mr-1"></i> Modifier
                </a>
                <form method="post" action="{{ path('app_patient_supp', {'id': patient.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce patient ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ patient.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash mr-1"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-info">Rendez-vous</h6>
            </div>
            <div class="card-body">
                {% if patient.rendezVous|length > 0 %}
                    {% for rdv in patient.rendezVous %}
                    <div class="mb-3 p-2 border rounded">
                        <small class="text-primary font-weight-bold">{{ rdv.date|date('d/m/Y') }} à {{ rdv.heure|date('H:i') }}</small><br>
                        <small class="text-gray-600">{{ rdv.motif }}</small><br>
                        {% if rdv.statut == 'Confirmé' %}
                            <span class="badge badge-success">{{ rdv.statut }}</span>
                        {% elseif rdv.statut == 'En attente' %}
                            <span class="badge badge-warning">{{ rdv.statut }}</span>
                        {% elseif rdv.statut == 'Annulé' %}
                            <span class="badge badge-danger">{{ rdv.statut }}</span>
                        {% else %}
                            <span class="badge badge-info">{{ rdv.statut }}</span>
                        {% endif %}
                    </div>
                    {% endfor %}
                {% else %}
                    <p class="text-center text-gray-500 mb-0">Aucun rendez-vous</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
