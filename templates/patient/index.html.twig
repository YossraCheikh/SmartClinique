{% extends 'base.html.twig' %}

{% block title %}Liste des Patients{% endblock %}

{% block body %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-users mr-2"></i>Liste des Patients</h1>
    <a href="{{ path('app_patient_new') }}" class="btn btn-primary btn-sm shadow-sm">
        <i class="fas fa-plus fa-sm mr-1"></i> Nouveau Patient
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Patients enregistrés</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Âge</th>
                        <th>Téléphone</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for patient in patients %}
                    <tr>
                        <td>{{ patient.id }}</td>
                        <td>{{ patient.nom }}</td>
                        <td>{{ patient.prenom }}</td>
                        <td>{{ patient.age }} ans</td>
                        <td><i class="fas fa-phone mr-1 text-success"></i>{{ patient.telephone }}</td>
                        <td><i class="fas fa-envelope mr-1 text-info"></i>{{ patient.email }}</td>
                        <td>
                            <a href="{{ path('app_patient_consult', {'id': patient.id}) }}" class="btn btn-info btn-sm" title="Consulter">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('app_patient_edit', {'id': patient.id}) }}" class="btn btn-warning btn-sm" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_patient_supp', {'id': patient.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce patient ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ patient.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="fas fa-inbox fa-2x text-gray-300 mb-2 d-block"></i>
                            Aucun patient enregistré.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
