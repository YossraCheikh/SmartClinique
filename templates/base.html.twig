<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Clinique - Système de gestion de clinique médicale">
    <title>{% block title %}Clinique{% endblock %} - Gestion Clinique</title>

    <!-- Custom fonts -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">

    <!-- SB Admin 2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/startbootstrap-sb-admin-2@4.1.4/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        .sidebar .nav-item .nav-link {
            padding: 0.75rem 1rem;
        }
        .sidebar .nav-item .nav-link i {
            margin-right: 0.5rem;
        }
        .card-counter {
            transition: all 0.3s ease;
        }
        .card-counter:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>

<body id="page-top">
    <!-- Page Wrapper -->
    <div id="wrapper">
        <!-- Sidebar -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <!-- Sidebar - Brand -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="{{ path('app_dashboard') }}">
                <div class="sidebar-brand-icon">
                    <i class="fas fa-hospital"></i>
                </div>
                <div class="sidebar-brand-text mx-3">Clinique</div>
            </a>

            <!-- Divider -->
            <hr class="sidebar-divider my-0">

            <!-- Nav Item - Dashboard -->
            <li class="nav-item {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                <a class="nav-link" href="{{ path('app_dashboard') }}">
                    <i class="fas fa-fw fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider">

            <!-- Heading -->
            <div class="sidebar-heading">Gestion</div>

            <!-- Nav Item - Patients Collapse Menu -->
            <li class="nav-item {{ 'app_patient' in app.request.attributes.get('_route') ? 'active' : '' }}">
                <a class="nav-link {{ 'app_patient' not in app.request.attributes.get('_route') ? 'collapsed' : '' }}" href="#" data-toggle="collapse" data-target="#collapsePatient"
                    aria-expanded="true" aria-controls="collapsePatient">
                    <i class="fas fa-fw fa-users"></i>
                    <span>Patients</span>
                </a>
                <div id="collapsePatient" class="collapse {{ 'app_patient' in app.request.attributes.get('_route') ? 'show' : '' }}" aria-labelledby="headingPatient" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <h6 class="collapse-header">Gestion Patients:</h6>
                        <a class="collapse-item {{ app.request.attributes.get('_route') == 'app_patient_index' ? 'active' : '' }}" href="{{ path('app_patient_index') }}">Afficher liste</a>
                        <a class="collapse-item {{ app.request.attributes.get('_route') == 'app_patient_new' ? 'active' : '' }}" href="{{ path('app_patient_new') }}">Ajouter patient</a>
                    </div>
                </div>
            </li>

            <!-- Nav Item - Médecins Collapse Menu -->
            <li class="nav-item {{ 'app_medecin' in app.request.attributes.get('_route') ? 'active' : '' }}">
                <a class="nav-link {{ 'app_medecin' not in app.request.attributes.get('_route') ? 'collapsed' : '' }}" href="#" data-toggle="collapse" data-target="#collapseMedecin"
                    aria-expanded="true" aria-controls="collapseMedecin">
                    <i class="fas fa-fw fa-user-md"></i>
                    <span>Médecins</span>
                </a>
                <div id="collapseMedecin" class="collapse {{ 'app_medecin' in app.request.attributes.get('_route') ? 'show' : '' }}" aria-labelledby="headingMedecin" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <h6 class="collapse-header">Gestion Médecins:</h6>
                        <a class="collapse-item {{ app.request.attributes.get('_route') == 'app_medecin_index' ? 'active' : '' }}" href="{{ path('app_medecin_index') }}">Afficher liste</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="collapse-item {{ app.request.attributes.get('_route') == 'app_medecin_new' ? 'active' : '' }}" href="{{ path('app_medecin_new') }}">Ajouter médecin</a>
                        {% endif %}
                    </div>
                </div>
            </li>

            <!-- Nav Item - Rendez-vous Collapse Menu -->
            <li class="nav-item {{ 'app_rendez_vous' in app.request.attributes.get('_route') ? 'active' : '' }}">
                <a class="nav-link {{ 'app_rendez_vous' not in app.request.attributes.get('_route') ? 'collapsed' : '' }}" href="#" data-toggle="collapse" data-target="#collapseRdv"
                    aria-expanded="true" aria-controls="collapseRdv">
                    <i class="fas fa-fw fa-calendar-alt"></i>
                    <span>Rendez-vous</span>
                </a>
                <div id="collapseRdv" class="collapse {{ 'app_rendez_vous' in app.request.attributes.get('_route') ? 'show' : '' }}" aria-labelledby="headingRdv" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <h6 class="collapse-header">Gestion Rendez-vous:</h6>
                        <a class="collapse-item {{ app.request.attributes.get('_route') == 'app_rendez_vous_index' ? 'active' : '' }}" href="{{ path('app_rendez_vous_index') }}">Afficher liste</a>
                        <a class="collapse-item {{ app.request.attributes.get('_route') == 'app_rendez_vous_new' ? 'active' : '' }}" href="{{ path('app_rendez_vous_new') }}">Ajouter RDV</a>
                    </div>
                </div>
            </li>

            <!-- Nav Item - Ordonnances Collapse Menu -->
            {% if is_granted('ROLE_ADMIN') %}
            <li class="nav-item {{ 'app_ordonnance' in app.request.attributes.get('_route') ? 'active' : '' }}">
                <a class="nav-link {{ 'app_ordonnance' not in app.request.attributes.get('_route') ? 'collapsed' : '' }}" href="#" data-toggle="collapse" data-target="#collapseOrdonnance"
                    aria-expanded="true" aria-controls="collapseOrdonnance">
                    <i class="fas fa-fw fa-file-prescription"></i>
                    <span>Ordonnances</span>
                </a>
                <div id="collapseOrdonnance" class="collapse {{ 'app_ordonnance' in app.request.attributes.get('_route') ? 'show' : '' }}" aria-labelledby="headingOrdonnance" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <h6 class="collapse-header">Gestion Ordonnances:</h6>
                        <a class="collapse-item {{ app.request.attributes.get('_route') == 'app_ordonnance_index' ? 'active' : '' }}" href="{{ path('app_ordonnance_index') }}">Afficher liste</a>
                        <a class="collapse-item {{ app.request.attributes.get('_route') == 'app_ordonnance_new' ? 'active' : '' }}" href="{{ path('app_ordonnance_new') }}">Ajouter ordonnance</a>
                    </div>
                </div>
            </li>
            {% endif %}

            <!-- Divider -->
            <hr class="sidebar-divider d-none d-md-block">

            <!-- Sidebar Toggler (Sidebar) -->
            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>
        </ul>
        <!-- End of Sidebar -->

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">
            <!-- Main Content -->
            <div id="content">
                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <!-- Sidebar Toggle (Topbar) -->
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <!-- Topbar Title -->
                    <span class="d-none d-sm-inline-block text-gray-600 font-weight-bold">
                        <i class="fas fa-hospital mr-2"></i>Système de Gestion de Clinique
                    </span>

                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">
                        <div class="topbar-divider d-none d-sm-block"></div>

                        <!-- Nav Item - User Information -->
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                {% if app.user %}
                                    <span class="mr-2 d-none d-lg-inline text-gray-600 small">
                                        {% if 'ROLE_ADMIN' in app.user.roles %}
                                            <span class="badge badge-primary ml-1">Admin</span>
                                        {% else %}
                                            <span class="badge badge-info ml-1">Secrétaire</span>
                                        {% endif %}
                                    </span>
                                {% endif %}
                                <i class="fas fa-user-circle fa-lg text-gray-400"></i>
                            </a>
                            <!-- Dropdown - User Information -->
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                                <div class="dropdown-header text-center">
                                    {% if app.user %}
                                        <strong>{{ app.user.email }}</strong>
                                    {% endif %}
                                </div>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="{{ path('app_logout') }}">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Déconnexion
                                </a>
                            </div>
                        </li>
                    </ul>
                </nav>
                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">
                    <!-- Flash messages -->
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                                <i class="fas fa-{{ label == 'success' ? 'check-circle' : (label == 'danger' ? 'exclamation-triangle' : 'info-circle') }} mr-2"></i>
                                {{ message }}
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </div>
                <!-- /.container-fluid -->
            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Clinique {{ "now"|date("Y") }} — Tous droits réservés</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->
        </div>
        <!-- End of Content Wrapper -->
    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Bootstrap core JavaScript-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.4.1/jquery.easing.min.js"></script>

    <!-- SB Admin 2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/startbootstrap-sb-admin-2@4.1.4/js/sb-admin-2.min.js"></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
