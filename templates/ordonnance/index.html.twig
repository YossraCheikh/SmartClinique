{% extends 'base.html.twig' %}

{% block title %}Liste des Ordonnances{% endblock %}

{% block body %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-file-prescription mr-2"></i>Liste des Ordonnances</h1>
    <a href="{{ path('app_ordonnance_new') }}" class="btn btn-primary btn-sm shadow-sm">
        <i class="fas fa-plus fa-sm mr-1"></i> Nouvelle Ordonnance
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Ordonnances enregistrées</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>RDV Associé</th>
                        <th>Patient</th>
                        <th>Médecin</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ordonnance in ordonnances %}
                    <tr>
                        <td>{{ ordonnance.id }}</td>
                        <td><i class="fas fa-calendar mr-1 text-primary"></i>{{ ordonnance.date|date('d/m/Y') }}</td>
                        <td><a href="{{ path('app_rendez_vous_consult', {'id': ordonnance.rendezVous.id}) }}">RDV #{{ ordonnance.rendezVous.id }}</a></td>
                        <td>{{ ordonnance.rendezVous.patient }}</td>
                        <td>{{ ordonnance.rendezVous.medecin }}</td>
                        <td>
                            <a href="{{ path('app_ordonnance_consult', {'id': ordonnance.id}) }}" class="btn btn-info btn-sm" title="Consulter">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('app_ordonnance_edit', {'id': ordonnance.id}) }}" class="btn btn-warning btn-sm" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_ordonnance_supp', {'id': ordonnance.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette ordonnance ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ordonnance.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            <i class="fas fa-file-medical-alt fa-2x text-gray-300 mb-2 d-block"></i>
                            Aucune ordonnance enregistrée.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
