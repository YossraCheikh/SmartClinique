{% extends 'base.html.twig' %}

{% block title %}Nouvelle Ordonnance{% endblock %}

{% block body %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-file-medical mr-2"></i>Nouvelle Ordonnance</h1>
    <a href="{{ path('app_ordonnance_index') }}" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left mr-1"></i> Retour à la liste
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Formulaire de création d'ordonnance</h6>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    {{ form_label(form.rendezVous) }}
                    {{ form_widget(form.rendezVous) }}
                    {{ form_errors(form.rendezVous) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    {{ form_label(form.date) }}
                    {{ form_widget(form.date) }}
                    {{ form_errors(form.date) }}
                </div>
            </div>
        </div>
        <div class="form-group">
            {{ form_label(form.medicaments) }}
            {{ form_widget(form.medicaments) }}
            {{ form_errors(form.medicaments) }}
        </div>
        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>
        <hr>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-1"></i> Enregistrer
        </button>
        <a href="{{ path('app_ordonnance_index') }}" class="btn btn-secondary ml-2">
            <i class="fas fa-times mr-1"></i> Annuler
        </a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
