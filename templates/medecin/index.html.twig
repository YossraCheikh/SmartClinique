{% extends 'base.html.twig' %}

{% block title %}Liste des Médecins{% endblock %}

{% block body %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-user-md mr-2"></i>Liste des Médecins</h1>
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_medecin_new') }}" class="btn btn-primary btn-sm shadow-sm">
        <i class="fas fa-plus fa-sm mr-1"></i> Nouveau Médecin
    </a>
    {% endif %}
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Médecins enregistrés</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Spécialité</th>
                        <th>Téléphone</th>
                        <th>Disponibilité</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for medecin in medecins %}
                    <tr>
                        <td>{{ medecin.id }}</td>
                        <td>{{ medecin.nom }}</td>
                        <td>{{ medecin.prenom }}</td>
                        <td><span class="badge badge-primary">{{ medecin.specialite }}</span></td>
                        <td><i class="fas fa-phone mr-1 text-success"></i>{{ medecin.telephone }}</td>
                        <td>
                            {% if medecin.disponibilite == 'Disponible' %}
                                <span class="badge badge-success">{{ medecin.disponibilite }}</span>
                            {% elseif medecin.disponibilite == 'Occupé' %}
                                <span class="badge badge-warning">{{ medecin.disponibilite }}</span>
                            {% elseif medecin.disponibilite == 'En congé' %}
                                <span class="badge badge-secondary">{{ medecin.disponibilite }}</span>
                            {% else %}
                                <span class="badge badge-light">Non défini</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_medecin_consult', {'id': medecin.id}) }}" class="btn btn-info btn-sm" title="Consulter">
                                <i class="fas fa-eye"></i>
                            </a>
                            {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_medecin_edit', {'id': medecin.id}) }}" class="btn btn-warning btn-sm" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_medecin_supp', {'id': medecin.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce médecin ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ medecin.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="fas fa-inbox fa-2x text-gray-300 mb-2 d-block"></i>
                            Aucun médecin enregistré.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
